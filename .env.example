# aistudio-api 环境变量配置
# 复制此文件为 .env 并按需修改

# ========== 服务基础配置 ==========
# HTTP 服务监听端口
AISTUDIO_PORT=8080
# HTTP 服务监听地址（0.0.0.0=对局域网/其它设备开放；127.0.0.1=仅本机）
AISTUDIO_HOST=0.0.0.0
# Web 管理控制台访问密码（设置后访问 / 自动启用登录拦截）
AISTUDIO_WEB_PASSWORD=
# AISTUDIO_ADMIN_PASSWORD=

# ========== 浏览器运行时 ==========
# Chromium 远程调试端口 (CDP)；池模式下第 N 台使用 该端口 + N（默认 9222/9223）
AISTUDIO_BROWSER_PORT=9222
# 浏览器 worker 池大小：1=单浏览器（旧行为），2=两台负载均衡 + 失败自愈（默认，夹在 1..4）
AISTUDIO_BROWSER_POOL_SIZE=2
# 浏览器无头模式（1=无头，0=有头调试）
AISTUDIO_BROWSER_HEADLESS=1
# Chromium 可执行文件绝对路径（留空自动探测系统安装的 Chrome/Chromium）
AISTUDIO_BROWSER_EXECUTABLE=

# ========== 网络代理与凭据 ==========
# HTTP / SOCKS5 出口代理（如 http://127.0.0.1:7890 或 socks5://127.0.0.1:1080）
AISTUDIO_PROXY=
# 主数据持久化根目录（留空默认使用 data/）
AISTUDIO_DATA_DIR=
# 账号凭据存储目录（留空默认使用 data/accounts）
AISTUDIO_ACCOUNTS_DIR=
# 模型调用与 Token 使用量统计持久化文件（留空默认使用 data/stats.json）
AISTUDIO_STATS_FILE=
# 账号调度与 429 冷却状态持久化文件（留空默认使用 data/rotator_state.json）
AISTUDIO_ROTATOR_STATE_FILE=
# 自定义 config.yaml 配置文件路径（留空默认使用项目根目录 config.yaml）
AISTUDIO_CONFIG_FILE=
# 认证文件路径（可选，单文件调试或导入时覆盖使用）
AISTUDIO_AUTH_FILE=
# 是否持久化模型调用与 Token 统计（1=开启，0=关闭）
AISTUDIO_PERSIST_STATS=1
# 是否持久化账号调度与 429 冷却状态（1=开启，0=关闭）
AISTUDIO_PERSIST_ROTATOR=1
# 临时文件目录（留空自动获取系统临时目录）
AISTUDIO_TMP_DIR=
# ========== 模型默认行为 ==========
AISTUDIO_DEFAULT_TEXT_MODEL=gemini-3.7-flash
AISTUDIO_DEFAULT_IMAGE_MODEL=gemini-3.1-flash-image-preview

# ========== 账号调度与重试 ==========

# ========== 调试输出 ==========
# 是否导出原始底层响应报文（1=开启，0=关闭）
AISTUDIO_DUMP_RAW_RESPONSE=0
# 原始报文导出目录
AISTUDIO_DUMP_RAW_RESPONSE_DIR=
